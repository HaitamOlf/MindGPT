# Copy to `.env` and fill in. NEVER commit the real .env.
# These are all public client identifiers (not secrets) — a SPA ships them in its bundle
# by design — but the backend URL and tenant values still live here, not in source.

# Backend API base URL (no trailing slash). Local dev points at the FastAPI dev server;
# in production this is the Container App / APIM origin.
VITE_API_BASE_URL=http://localhost:8000

# Microsoft Entra External ID (CIAM) — see docs/ENTRA_SETUP.md.
VITE_ENTRA_CLIENT_ID=79f16370-a10e-4851-bf6b-fb5dfbac210d
VITE_ENTRA_AUTHORITY=https://mindgpt.ciamlogin.com/cdae0a70-3b69-46b1-abb0-d9957189cbdd
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_API_SCOPE=api://c1f92635-804d-4d67-9376-72b4e08080e1/access_as_user
