# Copy to `.env` and fill in for local dev. NEVER commit the real .env.
# Mirrors the env vars infra/modules/build/container-apps.bicep injects in Azure —
# locally, point these at the real endpoints from `az deployment sub show` outputs,
# or leave blank to run with just /health working.

AZURE_CLIENT_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=

COSMOS_ENDPOINT=
COSMOS_DATABASE_NAME=mindgpt
BLOB_ENDPOINT=
SEARCH_ENDPOINT=
CONTENT_SAFETY_ENDPOINT=
LANGUAGE_ENDPOINT=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21

CORS_ALLOWED_ORIGIN=http://localhost:5173
PROMPT_LOGGING_ENABLED=false
# Swagger UI / ReDoc / OpenAPI schema. Off in production (recon-surface reduction); handy in
# local dev. Leave unset/false in any deployed environment.
ENABLE_API_DOCS=true

# Entra External ID (CIAM) — separate personal-account tenant, docs/ARCHITECTURE.md §11.
# Not secrets (tenant ID / client ID are public OIDC identifiers by design), so the real
# values are filled in here same as infra/main.bicepparam.
ENTRA_TENANT_ID=cdae0a70-3b69-46b1-abb0-d9957189cbdd
ENTRA_CIAM_DOMAIN=mindgpt
ENTRA_API_CLIENT_ID=c1f92635-804d-4d67-9376-72b4e08080e1
